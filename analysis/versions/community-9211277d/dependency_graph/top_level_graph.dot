digraph TopLevelDependencies {
  graph [
    label="Riemann Proof — Top-Level Mathematical Domain Dependency Graph\nEdge A -> B means A depends on B (A imports from B)\nBlue: primary cross-theory dependency | Slate: secondary | Indigo: Main entry chain | Dashed Amber: reverse coupling"
    labelloc=t
    fontsize=15
    fontname="Helvetica"
    rankdir=TB
    splines=true
    nodesep=0.95
    ranksep=0.95
    bgcolor="#0f172a"
    fontcolor="#f8fafc"
    pad=0.45
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, penwidth=2, margin="0.18,0.10"];
  edge [fontname="Helvetica", fontsize=9];

  _root_ [label="(root)\ndist>=0 | maxH=53", fillcolor="#334155", color="#94a3b8", fontcolor="#ffffff"];
  New [label="New\ndist>=1 | maxH=52", fillcolor="#1d4ed8", color="#60a5fa", fontcolor="#ffffff"];
  Lib [label="Lib\ndist>=4 | maxH=36", fillcolor="#047857", color="#34d399", fontcolor="#ffffff"];

  { rank=same; _root_; }
  { rank=same; New; }
  { rank=same; Lib; }

  New -> Lib [label=" 208 ", penwidth=3.67, color="#94a3b8", style=solid, fontcolor="#cbd5e1", constraint=true];
  _root_ -> New [label=" 1 (entry) ", penwidth=2.40, color="#a5b4fc", style=bold, fontcolor="#c7d2fe", constraint=true];
  New -> _root_ [label=" 1 ", penwidth=1.20, color="#64748b", style=dotted, fontcolor="#94a3b8", constraint=false];
}
