  GroundTheory -> Development [label=" 62 (rev) ", penwidth=3.06, color="#f59e0b", style=dashed, fontcolor="#fbbf24", constraint=false];
  ReciprocityTheory -> Lemmata [label=" 38 ", penwidth=2.82, color="#64748b", style=dotted, fontcolor="#94a3b8", constraint=true];
