digraph TopLevelDependencies {
  graph [
    label="Riemann Proof — Top-Level Mathematical Domain Dependency Graph\nEdge A -> B means A depends on B (A imports from B)\nBlue: primary cross-theory dependency | Slate: secondary | Indigo: Main entry chain | Dashed Amber: reverse coupling"
    labelloc=t
    fontsize=15
    fontname="Helvetica"
    rankdir=TB
    splines=true
    nodesep=0.95
    ranksep=0.95
    bgcolor="#0f172a"
    fontcolor="#f8fafc"
    pad=0.45
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, penwidth=2, margin="0.18,0.10"];
  edge [fontname="Helvetica", fontsize=9];

  _root_ [label="(root)\ndist>=0 | maxH=202", fillcolor="#334155", color="#94a3b8", fontcolor="#ffffff"];
  Supplements [label="Supplements\ndist>=1 | maxH=201", fillcolor="#3730a3", color="#818cf8", fontcolor="#ffffff"];
  Development [label="Development\ndist>=2 | maxH=198", fillcolor="#1d4ed8", color="#60a5fa", fontcolor="#ffffff"];
  CompanionTheory [label="CompanionTheory\ndist>=5 | maxH=114", fillcolor="#047857", color="#34d399", fontcolor="#ffffff"];
  PositivityTheory [label="PositivityTheory\ndist>=6 | maxH=111", fillcolor="#86198f", color="#e879f9", fontcolor="#ffffff"];
  Formalism [label="Formalism\ndist>=4 | maxH=93", fillcolor="#c2410c", color="#fb923c", fontcolor="#ffffff"];
  ReciprocityTheory [label="ReciprocityTheory\ndist>=6 | maxH=76", fillcolor="#0f766e", color="#2dd4bf", fontcolor="#ffffff"];
  GroundTheory [label="GroundTheory\ndist>=5 | maxH=68", fillcolor="#a16207", color="#facc15", fontcolor="#ffffff"];
  Lemmata [label="Lemmata\ndist>=8 | maxH=17", fillcolor="#6b21a8", color="#c084fc", fontcolor="#ffffff"];
  BuildAid [label="BuildAid\ndist>=8 | maxH=0", fillcolor="#4b5563", color="#9ca3af", fontcolor="#ffffff"];

  { rank=same; _root_; }
  { rank=same; Supplements; }
  { rank=same; Development; }
  { rank=same; CompanionTheory; PositivityTheory; }
  { rank=same; Formalism; GroundTheory; ReciprocityTheory; }
  { rank=same; Lemmata; BuildAid; }

  Development -> Formalism [label=" 41,857 ", penwidth=6.00, color="#38bdf8", style=solid, fontcolor="#bae6fd", constraint=true];
